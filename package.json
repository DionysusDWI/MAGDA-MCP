{
  "name": "@dionysusdwi/magda-mcp",
  "version": "0.1.0",
  "description": "MAGDA 0.20.2 MCP gateway with instance discovery, diagnostics and protocol adaptation for Windows.",
  "type": "module",
  "license": "MIT",
  "author": "DionysusDWI",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DionysusDWI/MAGDA-MCP.git"
  },
  "homepage": "https://github.com/DionysusDWI/MAGDA-MCP#readme",
  "bugs": {
    "url": "https://github.com/DionysusDWI/MAGDA-MCP/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "os": [
    "win32"
  ],
  "cpu": [
    "x64"
  ],
  "bin": {
    "magda-mcp-server": "dist/cli/index.js"
  },
  "files": [
    "dist/",
    "contracts/magda/0.20.2/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs/usage/",
    "docs/releases/v0.1.0.md",
    "docs/releases/live-acceptance-0.1.0.json",
    "docs/releases/permission-acceptance-0.1.0.json",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:live": "tsx scripts/live-test.ts",
    "capture:contract": "tsx scripts/capture-contract.ts",
    "check:package": "tsx scripts/check-package.ts",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/core": "2.3.1",
    "@modelcontextprotocol/server": "2.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@modelcontextprotocol/node": "2.1.1",
    "@types/node": "24.19.2",
    "eslint": "10.12.0",
    "tsx": "4.23.15",
    "typescript": "6.0.2",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.4"
  }
}
